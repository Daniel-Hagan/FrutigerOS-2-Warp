/* Frutiger-Aero for Qt apps (qt5ct / qt6ct style sheet, on top of Fusion) */
QPushButton, QToolButton[popupMode="1"] {
  border: 1px solid #7a9dbf; border-radius: 3px; padding: 4px 12px; color: #10223a;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fbfdff, stop:0.49 #e6eef6, stop:0.5 #d6e2ee, stop:1 #e8f0f8);
}
QPushButton:hover, QToolButton[popupMode="1"]:hover {
  border-color: #3c8ed8;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f4fbff, stop:0.49 #d4ecfd, stop:0.5 #b6dcf9, stop:1 #d0ecff);
}
QPushButton:pressed, QPushButton:checked {
  border-color: #2c628b;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #e5f4fc, stop:0.49 #c4e5f6, stop:0.5 #98d1ef, stop:1 #68b3db);
}
QPushButton:default { border-color: #2f7fc4; }
QToolButton:hover { border: 1px solid #7fb4e3; border-radius: 3px;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #fafdff, stop:0.5 #d8ecfc, stop:0.51 #c4e1fa, stop:1 #dcefff); }
QToolBar { border: none; border-bottom: 1px solid #a9c6e2;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f6fbff, stop:0.5 #dfeefa, stop:0.51 #d0e5f6, stop:1 #e3f0fb); }
QMenuBar { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f5faff, stop:1 #dbe9f7); }
QMenu { background: #f2f6fa; border: 1px solid #97a5b5; padding: 2px; }
QMenu::item { padding: 4px 22px 4px 26px; border: 1px solid transparent; border-radius: 3px; }
QMenu::item:selected { color: #10223a; border-color: #aeccef;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f1f8ff, stop:1 #dcebfd); }
QLineEdit, QSpinBox, QComboBox:editable { border: 1px solid #8fb0d0; border-radius: 2px; background: white; padding: 2px 4px; }
QLineEdit:focus { border-color: #3399ff; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
  color: #10223a; border: 1px solid #84acdd;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #e5f3ff, stop:1 #c4e2ff); }
QTreeView::item:hover, QListView::item:hover { background: #e5f3fb; }
QProgressBar { border: 1px solid #a0a0a0; border-radius: 2px; background: #e6e6e6; text-align: center; }
QProgressBar::chunk { border-radius: 1px;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #c8ffb0, stop:0.5 #5fd23a, stop:0.51 #2ea318, stop:1 #7ee05a); }
QSlider::sub-page:horizontal { border-radius: 2px; background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #8fd3ff, stop:1 #2a8fd8); }
QSlider::handle:horizontal { width: 14px; margin: -5px 0; border-radius: 7px; border: 1px solid #3c7fb1;
  background: qradialgradient(cx:0.5, cy:0.3, radius:0.7, fx:0.5, fy:0.3, stop:0 white, stop:0.6 #b8dcff, stop:1 #6fb2e8); }
QTabBar::tab { padding: 5px 12px; border: 1px solid #a9c6e2; border-bottom: none; border-top-left-radius: 3px; border-top-right-radius: 3px;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f4f9fe, stop:1 #dfeefa); }
QTabBar::tab:selected { background: white; border-top: 2px solid #2aa7e8; }
QToolTip { color: #2a3a4a; border: 1px solid #76808c; border-radius: 3px; padding: 2px 5px;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 white, stop:1 #e4ecf7); }
QScrollBar:vertical { width: 14px; background: #eef3f8; }
QScrollBar::handle:vertical { min-height: 24px; margin: 1px; border: 1px solid #9ab0c6; border-radius: 3px;
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #f4f8fc, stop:1 #dbe5ef); }
QScrollBar::handle:vertical:hover { border-color: #3c8ed8; }
QScrollBar:horizontal { height: 14px; background: #eef3f8; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 1px; border: 1px solid #9ab0c6; border-radius: 3px;
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f4f8fc, stop:1 #dbe5ef); }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
