#!/usr/bin/env python3
"""Frutiger OS — Lily Pond taskbar.

A small pond in the bottom-left corner with a lily pad per app. Running apps
bloom a lotus flower around their icon; the active one is a full, bright
bloom. Ripples spread across the water and idle pads drift gently. The orb
floats in the middle of the pond and opens the Start menu.
"""
import math, random, sys
sys.path.insert(0, "/usr/lib/frutiger")
from frutiger_strip import Strip, run, cairo

RX, RY = 160, 92      # pond radii
PAD = 22


class LilyPond(Strip):
    TITLE = "Frutiger Lily Pond"
    PRGNAME = "frutiger-lilypond"
    EDGE = "corner"
    CORNER_W, CORNER_H = 2 * RX + 20, 2 * RY + 20 + 40
    ORB = 40
    CLOCK = False
    item_radius = PAD
    FPS = 20

    def __init__(self):
        rnd = random.Random(3)
        self.ripples = [(rnd.uniform(-.7, .7), rnd.uniform(-.6, .6), rnd.random()) for _ in range(4)]
        self.bloom = {}
        super().__init__()

    def center(self):
        return (self.W / 2, self.H - RY - 10)

    def orb_center(self):
        return self.center() if hasattr(self, "W") else (0, 0)

    def place(self):
        super().place()
        self.orb_hit = self.center() + (self.ORB / 2,)

    def after_realize(self):
        cx, cy = self.center()
        reg = cairo.Region()
        for y in range(int(cy - RY), int(cy + RY), 4):
            half = RX * math.sqrt(max(0, 1 - ((y + 2 - cy) / RY) ** 2))
            reg.union(cairo.RectangleInt(int(cx - half), y, int(2 * half), 4))
        self.input_shape_combine_region(reg)
        return False

    def pond(self, cr, cx, cy, grow=0):
        cr.save()
        cr.translate(cx, cy)
        cr.scale(RX + grow, RY + grow)
        cr.arc(0, 0, 1, 0, 2 * math.pi)
        cr.restore()

    def draw_background(self, cr, w, h, top, t):
        cx, cy = self.center()
        self.pond(cr, cx, cy + 4)
        cr.set_source_rgba(0, .1, .2, .25)
        cr.fill()
        self.pond(cr, cx, cy, 5)                           # grassy bank
        cr.set_source_rgba(.42, .76, .3, .9)
        cr.fill()
        self.pond(cr, cx, cy)
        g = cairo.RadialGradient(cx - 30, cy - 30, 10, cx, cy, RX)
        g.add_color_stop_rgba(0, .72, .95, 1, .95)
        g.add_color_stop_rgba(.6, .25, .72, .9, .92)
        g.add_color_stop_rgba(1, .05, .42, .62, .95)
        cr.set_source(g)
        cr.fill()
        for fx, fy, ph in self.ripples:                    # expanding ripples
            p = (t * .25 + ph) % 1
            cr.save()
            cr.translate(cx + fx * RX * .8, cy + fy * RY * .8)
            cr.scale(1, .45)
            cr.arc(0, 0, 6 + p * 40, 0, 2 * math.pi)
            cr.restore()
            cr.set_source_rgba(1, 1, 1, .5 * (1 - p))
            cr.set_line_width(1.2)
            cr.stroke()
        self.pond(cr, cx, cy)                              # rim highlight
        cr.set_source_rgba(1, 1, 1, .7)
        cr.set_line_width(1.5)
        cr.stroke()

    def item_pos(self, i, n, it, w, top, t):
        cx, cy = self.center()
        ring = 10
        if i < ring:
            m = min(n, ring)
            a = -math.pi / 2 + (i + .5) * 2 * math.pi / m
            rx, ry = RX * .68, RY * .62
        else:
            m = n - ring
            a = (i - ring + .5) * 2 * math.pi / max(1, m)
            rx, ry = RX * .36, RY * .32
        bob = math.sin(t * .8 + it.seed * 6.28) * 1.5
        return cx + math.cos(a) * rx, cy + math.sin(a) * ry + bob

    def draw_item(self, cr, it, x, y, t, hover):
        target = 1.0 if it.running else 0.0                # bloom eases open / shut
        b = self.bloom.get(it.key, target)
        b += (target - b) * .15
        self.bloom[it.key] = b
        rot = math.sin(t * .3 + it.seed * 6.28) * .2 + it.seed * 6.28
        cr.save()                                          # lily pad with its notch
        cr.translate(x, y + 3)
        cr.rotate(rot)
        cr.scale(1, .62)
        cr.move_to(0, 0)
        cr.arc(0, 0, PAD, .25, 2 * math.pi - .25)
        cr.close_path()
        cr.restore()
        pg = cairo.LinearGradient(x - PAD, y - PAD, x + PAD, y + PAD)
        pg.add_color_stop_rgba(0, .6, .9, .38, 1)
        pg.add_color_stop_rgba(1, .2, .56, .2, 1)
        cr.set_source(pg)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, .6)
        cr.set_line_width(1)
        cr.stroke()
        if b > .02:                                        # lotus petals
            bright = 1.0 if it.active else .85
            for k in range(8):
                a = k * math.pi / 4 + t * .05
                cr.save()
                cr.translate(x, y - 2)
                cr.rotate(a)
                cr.scale(1, .5)
                cr.arc(0, -10 * b, 9 * b, 0, 2 * math.pi)
                cr.restore()
                cr.set_source_rgba(1, .72 * bright + .1, .85, .85 * b)
                cr.fill()
            if it.attention:
                cr.arc(x, y - 2, 20 + math.sin(t * 4) * 3, 0, 2 * math.pi)
                cr.set_source_rgba(1, .9, .5, .7)
                cr.set_line_width(2)
                cr.stroke()
        self.paint_icon(cr, it, x, y - 2, 20, 1.0 if it.running else .75)
        if it.active:
            for k in range(3):                             # sparkles
                a = t * 1.5 + k * 2.1
                cr.arc(x + math.cos(a) * 18, y - 4 + math.sin(a) * 9, 1.6, 0, 2 * math.pi)
                cr.set_source_rgba(1, 1, 1, .95)
                cr.fill()


if __name__ == "__main__":
    run(LilyPond)
