#!/usr/bin/env python3
"""Frutiger OS — Vista Sidebar taskbar.

A tall glass column on the right edge of the screen, after Windows Vista's
Sidebar: the Start orb and gadgets (analog clock, date, CPU and memory meters)
at the top, your apps as glass tiles below. Running apps' tiles light up, the
active one is highlighted. Maximized windows stop at the sidebar's edge.
"""
import math, sys, time
sys.path.insert(0, "/usr/lib/frutiger")
from frutiger_strip import Strip, run, rounded, accent, cairo, GLib

TILE_W, TILE_H, GAP = 132, 40, 6
APPS_TOP = 318


def read_cpu():
    with open("/proc/stat") as f:
        v = [int(x) for x in f.readline().split()[1:]]
    idle = v[3] + v[4]
    return idle, sum(v)


def read_mem():
    m = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, val = line.split(":")
            m[k] = int(val.split()[0])
    return 1 - m.get("MemAvailable", 0) / max(1, m.get("MemTotal", 1))


class Sidebar(Strip):
    TITLE = "Frutiger Sidebar"
    PRGNAME = "frutiger-sidebar"
    EDGE = "right"
    STRIP_H = 150          # sidebar width
    EXTRA_H = 200          # click-through room on the left for labels
    ORB = 44
    CLOCK = False
    FPS = 10
    item_radius = TILE_H / 2

    def __init__(self):
        self.cpu, self.mem, self._cpu_prev = 0.0, 0.0, read_cpu()
        super().__init__()
        GLib.timeout_add_seconds(2, self.sample)

    def sample(self):
        idle, total = read_cpu()
        pi, pt = self._cpu_prev
        self.cpu = 1 - (idle - pi) / max(1, total - pt)
        self._cpu_prev = (idle, total)
        self.mem = read_mem()
        return True

    def draw_background(self, cr, w, h, top, t):
        x, y, sw, sh = self.rect
        ar, ag, ab = accent()
        g = cairo.LinearGradient(x, 0, x + sw, 0)
        g.add_color_stop_rgba(0, .04, .14, .26, .55)
        g.add_color_stop_rgba(1, ar * .4, ag * .4, ab * .5, .45)
        cr.rectangle(x, 0, sw, sh)
        cr.set_source(g)
        cr.fill()
        cr.move_to(x + .5, 0)                              # glossy left edge
        cr.line_to(x + .5, sh)
        cr.set_source_rgba(1, 1, 1, .6)
        cr.set_line_width(1)
        cr.stroke()
        gl = cairo.LinearGradient(x, 0, x + sw, 0)
        gl.add_color_stop_rgba(0, 1, 1, 1, .18)
        gl.add_color_stop_rgba(.5, 1, 1, 1, 0)
        cr.rectangle(x, 0, sw, sh)
        cr.set_source(gl)
        cr.fill()
        self.draw_gadgets(cr, x, sw)

    def gadget_box(self, cr, x, y, w, h):
        rounded(cr, x, y, w, h, 10)
        g = cairo.LinearGradient(0, y, 0, y + h)
        g.add_color_stop_rgba(0, 1, 1, 1, .32)
        g.add_color_stop_rgba(.5, 1, 1, 1, .12)
        g.add_color_stop_rgba(.51, 1, 1, 1, .05)
        g.add_color_stop_rgba(1, 1, 1, 1, .14)
        cr.set_source(g)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, .45)
        cr.set_line_width(1)
        cr.stroke()

    def text(self, cr, s, cx, y, size, alpha=1.0, bold=False):
        cr.select_font_face("Noto Sans", cairo.FONT_SLANT_NORMAL,
                            cairo.FONT_WEIGHT_BOLD if bold else cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(size)
        e = cr.text_extents(s)
        cr.move_to(cx - e.width / 2 - e.x_bearing, y)
        cr.set_source_rgba(0, 0, 0, .5 * alpha)
        cr.show_text(s)
        cr.move_to(cx - e.width / 2 - e.x_bearing - 1, y - 1)
        cr.set_source_rgba(1, 1, 1, alpha)
        cr.show_text(s)

    def draw_gadgets(self, cr, x, sw):
        cx = x + sw / 2
        # clock gadget
        self.gadget_box(cr, x + 9, 70, sw - 18, 150)
        ccy, R = 70 + 64, 50
        face = cairo.RadialGradient(cx - 15, ccy - 20, 4, cx, ccy, R)
        face.add_color_stop_rgba(0, 1, 1, 1, 1)
        face.add_color_stop_rgba(.75, .88, .94, 1, 1)
        face.add_color_stop_rgba(1, .6, .76, .92, 1)
        cr.arc(cx, ccy, R, 0, 2 * math.pi)
        cr.set_source(face)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 1)
        cr.set_line_width(2.5)
        cr.stroke()
        for k in range(12):
            a = k * math.pi / 6
            cr.move_to(cx + math.sin(a) * (R - 8), ccy - math.cos(a) * (R - 8))
            cr.line_to(cx + math.sin(a) * (R - 3), ccy - math.cos(a) * (R - 3))
            cr.set_source_rgba(.2, .33, .48, .8)
            cr.set_line_width(1.5)
            cr.stroke()
        lt = time.localtime()
        s = lt.tm_sec + time.time() % 1
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        for a, ln, wd, col in (((lt.tm_hour % 12 + lt.tm_min / 60) * math.pi / 6, 26, 3.5, (.1, .2, .36)),
                               ((lt.tm_min + s / 60) * math.pi / 30, 38, 2.5, (.1, .2, .36)),
                               (s * math.pi / 30, 42, 1, (.88, .25, .1))):
            cr.move_to(cx, ccy)
            cr.line_to(cx + math.sin(a) * ln, ccy - math.cos(a) * ln)
            cr.set_source_rgba(*col, 1)
            cr.set_line_width(wd)
            cr.stroke()
        self.text(cr, time.strftime("%A, %b %-d"), cx, 210, 12)
        # CPU / memory meter gadget
        self.gadget_box(cr, x + 9, 230, sw - 18, 72)
        for i, (name, v) in enumerate((("CPU", self.cpu), ("Memory", self.mem))):
            yy = 250 + i * 30
            self.text(cr, "%s  %d%%" % (name, round(v * 100)), cx, yy, 11)
            bx, bw = x + 20, sw - 40
            rounded(cr, bx, yy + 5, bw, 8, 4)
            cr.set_source_rgba(0, 0, 0, .35)
            cr.fill()
            if v > .01:
                rounded(cr, bx, yy + 5, max(8, bw * v), 8, 4)
                gg = cairo.LinearGradient(0, yy + 5, 0, yy + 13)
                gg.add_color_stop_rgba(0, .78, 1, .69, 1)
                gg.add_color_stop_rgba(.5, .37, .82, .23, 1)
                gg.add_color_stop_rgba(.51, .18, .64, .09, 1)
                gg.add_color_stop_rgba(1, .49, .88, .35, 1)
                cr.set_source(gg)
                cr.fill()

    def item_pos(self, i, n, it, w, top, t):
        x, y, sw, sh = self.rect
        rows = max(1, int((sh - APPS_TOP - 10) // (TILE_H + GAP)))
        return x + sw / 2, APPS_TOP + (min(i, rows - 1)) * (TILE_H + GAP) + TILE_H / 2

    def hit(self, px, py):
        for it in self.items:
            if it.key in self.pos:
                x, y = self.pos[it.key]
                if abs(px - x) <= TILE_W / 2 and abs(py - y) <= TILE_H / 2:
                    return it
        return None

    def draw_item(self, cr, it, x, y, t, hover):
        tx, ty = x - TILE_W / 2, y - TILE_H / 2
        rounded(cr, tx, ty, TILE_W, TILE_H, 6)
        g = cairo.LinearGradient(0, ty, 0, ty + TILE_H)
        if it.active:
            g.add_color_stop_rgba(0, .75, .9, 1, .75)
            g.add_color_stop_rgba(.5, .45, .72, .98, .6)
            g.add_color_stop_rgba(.51, .25, .55, .9, .55)
            g.add_color_stop_rgba(1, .45, .78, 1, .7)
        elif it.running or hover:
            g.add_color_stop_rgba(0, 1, 1, 1, .38)
            g.add_color_stop_rgba(.5, 1, 1, 1, .16)
            g.add_color_stop_rgba(.51, 1, 1, 1, .06)
            g.add_color_stop_rgba(1, 1, 1, 1, .2)
        else:
            g.add_color_stop_rgba(0, 1, 1, 1, .12)
            g.add_color_stop_rgba(1, 1, 1, 1, .04)
        cr.set_source(g)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, .7 if (it.running or it.active) else .25)
        cr.set_line_width(1)
        cr.stroke()
        a = 1.0 if it.running else .7
        self.paint_icon(cr, it, tx + 22, y, 24, a)
        name = it.label if len(it.label) < 13 else it.label[:12] + "…"
        cr.select_font_face("Noto Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(12)
        e = cr.text_extents(name)
        cr.move_to(tx + 42, y + e.height / 2)
        cr.set_source_rgba(1, 1, 1, a)
        cr.show_text(name)
        if it.attention:
            rounded(cr, tx - 1, ty - 1, TILE_W + 2, TILE_H + 2, 7)
            cr.set_source_rgba(1, .75, .3, .5 + .5 * math.sin(t * 4))
            cr.set_line_width(2)
            cr.stroke()


if __name__ == "__main__":
    run(Sidebar)
