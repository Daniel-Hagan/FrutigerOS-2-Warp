#!/usr/bin/env python3
"""Frutiger OS — Welcome Center (opens on first login; also in the Start menu).

A short tour, then quick choices: taskbar style, glass color, wallpaper and
gadgets — plus links to get started. Everything here can be changed later in
Personalize.
"""
import os, re, subprocess, sys
sys.path.insert(0, "/usr/lib/frutiger")
import frutiger_settings as fs
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GdkPixbuf

CONF = os.path.expanduser("~/.config/frutiger")
DONE = os.path.join(CONF, "welcome-done")
STYLES = [("dock", "Bubble Dock"), ("orbit", "Orbit Launcher"), ("aquarium", "Aquarium Rail"), ("leaf", "Leaf Shelf"),
          ("cloud", "Cloud Bar"), ("beads", "Glass Bead String"), ("ribbon", "Aurora Ribbon"), ("sundial", "Sundial Clock"),
          ("pond", "Lily Pond"), ("sidebar", "Vista Sidebar"), ("flip", "Flip 3D Carousel"), ("classic", "Classic taskbar")]
COLORS = ["#2aa7e8", "#20c4b8", "#5fcf3a", "#f0b42a", "#f06a8a", "#a46ae8"]

CSS = b"""
#welcome-hero { background-image: linear-gradient(to bottom, #36a6f0, #7fd0ff 60%, #d8f4ff); }
#welcome-hero label { color: white; text-shadow: 0 1px 4px alpha(#003366,.7); }
.big { font-size: 22px; font-weight: 300; }
.tile { border-radius: 10px; padding: 10px; border: 1px solid #c9dcee; background-image: linear-gradient(to bottom, white, #eef6fd); }
"""


def label(text, cls=None, wrap=True):
    l = Gtk.Label(xalign=0)
    l.set_markup(text)
    l.set_line_wrap(wrap)
    if cls:
        l.get_style_context().add_class(cls)
    return l


class Welcome(Gtk.Window):
    def __init__(self):
        super().__init__(title="Welcome Center")
        self.set_default_size(720, 520)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("frutiger-os")
        p = Gtk.CssProvider()
        p.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)
        hero = Gtk.Box(spacing=16)
        hero.set_name("welcome-hero")
        hero.set_border_width(0)
        try:
            img = Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_size(
                "/usr/share/plymouth/themes/frutiger/bubble.png", 110, 110))
            hero.pack_start(img, False, False, 14)
        except Exception:
            pass
        hb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        hb.set_valign(Gtk.Align.CENTER)
        hb.pack_start(label("Welcome to Frutiger OS", "big"), False, False, 0)
        hb.pack_start(label("Let's make it yours. It only takes a minute — and you can change anything later in Personalize."), False, False, 0)
        hero.pack_start(hb, True, True, 0)
        root.pack_start(hero, False, False, 0)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_border_width(20)
        root.pack_start(self.stack, True, True, 0)
        self.cfg = fs.load()
        self.pages = ["tour", "taskbar", "desktop", "start"]
        self.stack.add_named(self.page_tour(), "tour")
        self.stack.add_named(self.page_taskbar(), "taskbar")
        self.stack.add_named(self.page_desktop(), "desktop")
        self.stack.add_named(self.page_start(), "start")

        nav = Gtk.Box(spacing=8)
        nav.set_border_width(12)
        self.show_again = Gtk.CheckButton(label="Show this at startup")
        self.show_again.set_active(not os.path.exists(DONE))
        nav.pack_start(self.show_again, False, False, 0)
        self.back = Gtk.Button(label="Back")
        self.next = Gtk.Button(label="Next")
        self.next.get_style_context().add_class("suggested-action")
        self.back.connect("clicked", lambda *_: self.go(-1))
        self.next.connect("clicked", lambda *_: self.go(1))
        nav.pack_end(self.next, False, False, 0)
        nav.pack_end(self.back, False, False, 0)
        root.pack_end(nav, False, False, 0)
        self.connect("destroy", self.on_close)
        self.go(0)

    def go(self, step):
        i = self.pages.index(self.stack.get_visible_child_name() or "tour") + step
        if i >= len(self.pages):
            self.destroy()
            return
        i = max(0, i)
        self.stack.set_visible_child_name(self.pages[i])
        self.back.set_sensitive(i > 0)
        self.next.set_label("Finish" if i == len(self.pages) - 1 else "Next")

    def tile(self, title, text):
        b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        b.get_style_context().add_class("tile")
        b.pack_start(label("<b>%s</b>" % title), False, False, 0)
        b.pack_start(label("<small>%s</small>" % text), False, False, 0)
        return b

    def page_tour(self):
        g = Gtk.Grid(column_spacing=12, row_spacing=12, column_homogeneous=True)
        tiles = [("The Start orb", "Your apps, files and settings. Press the Super key or click the orb."),
                 ("Twelve taskbars", "Bubbles, koi, leaves, clouds, a sundial… pick the one you like."),
                 ("Glass everywhere", "Choose the glass color and how strong the blur is."),
                 ("A living desktop", "Wallpapers that follow the time of day, bubbles and ripples, optional weather."),
                 ("Gadgets", "Clock, weather, CPU meter, sticky note and photo slideshow — each one optional."),
                 ("Calm mode", "One switch turns off everything that moves.")]
        for i, (t, d) in enumerate(tiles):
            g.attach(self.tile(t, d), i % 3, i // 3, 1, 1)
        return g

    def page_taskbar(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.pack_start(label("<b>Pick a taskbar style</b>  <small>(it changes right away)</small>"), False, False, 0)
        flow = Gtk.FlowBox(max_children_per_line=3, selection_mode=Gtk.SelectionMode.NONE, homogeneous=True)
        current = open(os.path.join(CONF, "taskbar")).read().strip() if os.path.exists(os.path.join(CONF, "taskbar")) else "dock"
        group = None
        for key, name in STYLES:
            rb = Gtk.RadioButton.new_with_label_from_widget(group, name)
            group = group or rb
            rb.set_active(key == current)
            rb.connect("toggled", lambda b, k=key: b.get_active() and subprocess.Popen(["frutiger-taskbar", k]))
            flow.add(rb)
        box.pack_start(flow, False, False, 0)
        box.pack_start(label("<b>Glass color</b>"), False, False, 6)
        row = Gtk.Box(spacing=8)
        for c in COLORS:
            b = Gtk.Button()
            b.set_size_request(44, 30)
            css = Gtk.CssProvider()
            css.load_from_data(("button{background-image:linear-gradient(to bottom, alpha(white,.6), alpha(white,.1) 50%%, transparent 51%%);"
                                "background-color:%s;}" % c).encode())
            b.get_style_context().add_provider(css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            b.connect("clicked", lambda _b, c=c: self.set_color(c))
            row.pack_start(b, False, False, 0)
        box.pack_start(row, False, False, 0)
        return box

    def set_color(self, c):
        os.makedirs(CONF, exist_ok=True)
        open(os.path.join(CONF, "accent"), "w").write(c + "\n")
        css = os.path.expanduser("~/.config/gtk-3.0/gtk.css")
        os.makedirs(os.path.dirname(css), exist_ok=True)
        old = open(css).read() if os.path.exists(css) else ""
        old = re.sub(r"/\* frutiger-personalize: begin \*/.*?/\* frutiger-personalize: end \*/\n?", "", old, flags=re.S)
        open(css, "w").write(old + "/* frutiger-personalize: begin */\n@define-color accent %s;\n/* frutiger-personalize: end */\n" % c)
        for t in ("Adwaita", "Frutiger-Aero"):
            subprocess.run(["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName", "-s", t])

    def page_desktop(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.pack_start(label("<b>Your desktop</b>"), False, False, 0)
        self.toggles = {}
        g = Gtk.Grid(column_spacing=12, row_spacing=8)
        rows = [("wallpaper_dynamic", "Wallpaper follows the time of day", "Dawn, midday, sunset and a starry night"),
                ("live_effects", "Live effects", "Bubbles rise and the water ripples"),
                ("gadgets", "Desktop gadgets", "Clock, weather and CPU meter (choose more in Personalize)"),
                ("sounds", "Frutiger sounds", "Startup chime, water-drop notifications, bubble pops"),
                ("calm_mode", "Calm mode", "Turn off everything that moves")]
        for i, (k, t, d) in enumerate(rows):
            sw = Gtk.Switch()
            sw.set_valign(Gtk.Align.CENTER)
            sw.set_active(self.cfg.get("wallpaper_mode") == "timeofday" if k == "wallpaper_dynamic" else self.cfg.get(k) == "on")
            l = label("%s\n<small>%s</small>" % (t, d))
            l.set_hexpand(True)
            g.attach(l, 0, i, 1, 1)
            g.attach(sw, 1, i, 1, 1)
            self.toggles[k] = sw
        box.pack_start(g, False, False, 0)
        return box

    def page_start(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.pack_start(label("<b>Get started</b>"), False, False, 0)
        g = Gtk.Grid(column_spacing=12, row_spacing=12, column_homogeneous=True)
        links = [("Browse the web", ["firefox-esr"]), ("Your files", ["thunar"]), ("Personalize", ["frutiger-personalize"]),
                 ("Get more apps (Flathub)", ["xdg-open", "https://flathub.org"]),
                 ("Install Frutiger OS", ["sh", "-c", "install-debian || calamares"]), ("Terminal", ["xfce4-terminal"])]
        for i, (t, cmd) in enumerate(links):
            if t == "Install Frutiger OS" and not os.path.isdir("/run/live"):
                continue
            b = Gtk.Button(label=t)
            b.connect("clicked", lambda _b, cmd=cmd: subprocess.Popen(cmd))
            g.attach(b, i % 3, i // 3, 1, 1)
        box.pack_start(g, False, False, 0)
        return box

    def on_close(self, *_):
        c = fs.load()
        for k, sw in getattr(self, "toggles", {}).items():
            if k == "wallpaper_dynamic":
                c["wallpaper_mode"] = "timeofday" if sw.get_active() else "static"
            else:
                c[k] = "on" if sw.get_active() else "off"
        fs.save(c)
        os.makedirs(CONF, exist_ok=True)
        if self.show_again.get_active():
            if os.path.exists(DONE):
                os.remove(DONE)
        else:
            open(DONE, "w").close()
        Gtk.main_quit()


if __name__ == "__main__":
    Welcome().show_all()
    Gtk.main()
