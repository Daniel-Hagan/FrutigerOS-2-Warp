#!/usr/bin/env python3
"""Frutiger OS — Aurora Ribbon taskbar.

A translucent ribbon of light flows slowly along the bottom of the screen and
app icons ride its waves. Running apps carry a soft halo, the active one a
brighter halo with a sparkle; pinned apps that aren't running are dimmer.
"""
import colorsys, math, sys
sys.path.insert(0, "/usr/lib/frutiger")
from frutiger_strip import Strip, run, accent, cairo


class Ribbon(Strip):
    TITLE = "Frutiger Aurora Ribbon"
    PRGNAME = "frutiger-ribbon"
    STRIP_H = 58
    EXTRA_H = 44
    item_radius = 22

    def wave(self, x, t, phase=0.0, amp=8):
        return self.top + self.STRIP_H * .52 + math.sin(x / 130 + t * .8 + phase) * amp \
            + math.sin(x / 57 - t * .5 + phase * 2) * amp * .35

    def draw_background(self, cr, w, h, top, t):
        hue = colorsys.rgb_to_hls(*accent())[0]
        bands = [(hue + .08, 0, 14, .30), (hue, 1.3, 10, .38), (hue - .1, 2.4, 7, .30)]
        for bh, ph, thick, al in bands:
            r, g, b = colorsys.hls_to_rgb(bh % 1, .62, .85)
            cr.move_to(0, self.wave(0, t, ph) - thick)
            for x in range(0, w + 24, 24):
                cr.line_to(x, self.wave(x, t, ph) - thick)
            for x in range(w + 24, -24, -24):
                cr.line_to(x, self.wave(x, t, ph) + thick)
            cr.close_path()
            g_ = cairo.LinearGradient(0, 0, w, 0)
            g_.add_color_stop_rgba(0, r, g, b, 0)
            g_.add_color_stop_rgba(.08, r, g, b, al)
            g_.add_color_stop_rgba(.92, r, g, b, al)
            g_.add_color_stop_rgba(1, r, g, b, 0)
            cr.set_source(g_)
            cr.fill()
        cr.move_to(0, self.wave(0, t, 1.3))               # a bright filament through the middle
        for x in range(0, w + 24, 24):
            cr.line_to(x, self.wave(x, t, 1.3))
        cr.set_source_rgba(1, 1, 1, .55)
        cr.set_line_width(1.2)
        cr.stroke()

    def item_pos(self, i, n, it, w, top, t):
        x0, x1 = 100, w - 130
        step = min(76, (x1 - x0) / max(1, n))
        x = x0 + step * (i + .5)
        return x, self.wave(x, t, 1.3) - 2

    def draw_item(self, cr, it, x, y, t, hover):
        a = 1.0 if it.running else .6
        if it.running:
            rad = 30 if it.active else 22
            pulse = (.6 + .4 * math.sin(t * 4)) if it.attention else 1
            g = cairo.RadialGradient(x, y, 2, x, y, rad)
            g.add_color_stop_rgba(0, 1, 1, 1, (.75 if it.active else .45) * pulse)
            g.add_color_stop_rgba(1, 1, 1, 1, 0)
            cr.set_source(g)
            cr.arc(x, y, rad, 0, 2 * math.pi)
            cr.fill()
        self.paint_icon(cr, it, x, y, 32, a)
        if it.active:                                     # four-point sparkle
            sx, sy = x + 14, y - 14
            s = 5 + math.sin(t * 3) * 1.5
            cr.move_to(sx, sy - s)
            cr.line_to(sx + 1.2, sy - 1.2)
            cr.line_to(sx + s, sy)
            cr.line_to(sx + 1.2, sy + 1.2)
            cr.line_to(sx, sy + s)
            cr.line_to(sx - 1.2, sy + 1.2)
            cr.line_to(sx - s, sy)
            cr.line_to(sx - 1.2, sy - 1.2)
            cr.close_path()
            cr.set_source_rgba(1, 1, 1, .95)
            cr.fill()
        n = len(it.windows)
        for j in range(min(n, 4) if n > 1 else 0):
            cr.arc(x - (min(n, 4) - 1) * 4 + j * 8, y + 22, 2, 0, 2 * math.pi)
            cr.set_source_rgba(1, 1, 1, .95)
            cr.fill()


if __name__ == "__main__":
    run(Ribbon)
