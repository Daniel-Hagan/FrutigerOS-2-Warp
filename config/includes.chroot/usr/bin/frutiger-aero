#!/usr/bin/env python3
"""Frutiger OS — Aero touches for app windows (started at login by frutiger-session).

  * title-bar shine   when you switch to a window, a band of light sweeps across its title bar
  * rain on the glass while it's raining (weather effects), drops gather on the active
                      window's title bar and some trickle down its edges
  * peek corner       rest the pointer in the bottom-right corner and every window turns to
                      faint glass so you can see the desktop (Aero Peek)

All three draw in small click-through layers and need a compositor (picom or
xfwm4's); each has a switch in Personalize → Desktop, and Calm mode stops the
moving ones.
"""
import math, os, random, sys, time
sys.path.insert(0, "/usr/lib/frutiger")
import frutiger_settings as fs
import frutiger_peek as peek
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Wnck", "3.0")
from gi.repository import Gtk, Gdk, GLib, Wnck
import cairo

RAINING = os.path.expanduser("~/.cache/frutiger/raining")
TITLE_H = 30


class Layer(Gtk.Window):
    """A borderless, click-through, always-on-top transparent window."""
    def __init__(self, title):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.set_title(title)
        self.set_app_paintable(True)
        vis = self.get_screen().get_rgba_visual()
        if vis:
            self.set_visual(vis)
        self.connect("realize", lambda *a: self.input_shape_combine_region(cairo.Region()))
        self.connect("draw", self.on_draw)

    def place(self, x, y, w, h):
        self.move(int(x), int(y))
        self.resize(max(1, int(w)), max(1, int(h)))

    def on_draw(self, _w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        self.paint(cr)
        return False

    def paint(self, cr):
        pass


class Shine(Layer):
    DUR = .95

    def __init__(self):
        super().__init__("Frutiger Shine")
        self.t0, self.w = 0, 1

    def sweep(self, geo):
        x, y, w, _h = geo
        self.w = w
        self.place(x, y, w, TITLE_H + 6)
        self.t0 = time.monotonic()
        self.show_all()
        GLib.timeout_add(16, self.tick)

    def tick(self):
        if time.monotonic() - self.t0 > self.DUR:
            self.hide()
            return False
        self.queue_draw()
        return True

    def paint(self, cr):
        p = min(1, (time.monotonic() - self.t0) / self.DUR)
        p = 1 - (1 - p) ** 2                                  # ease out
        w, h = self.w, TITLE_H + 6
        cx = -w * .35 + p * w * 1.7
        cr.save()
        cr.translate(cx, 0)
        g = cairo.LinearGradient(-w * .18, 0, w * .18, 0)
        g.add_color_stop_rgba(0, 1, 1, 1, 0)
        g.add_color_stop_rgba(.45, 1, 1, 1, .62)
        g.add_color_stop_rgba(.55, 1, 1, 1, .3)
        g.add_color_stop_rgba(1, 1, 1, 1, 0)
        cr.move_to(-w * .2 + 10, 0)
        cr.line_to(w * .2 + 10, 0)
        cr.line_to(w * .2 - 10, h)
        cr.line_to(-w * .2 - 10, h)
        cr.close_path()
        cr.set_source(g)
        cr.fill()
        cr.restore()
        # fade the sweep out toward the window's bottom edge of the title bar
        cr.set_operator(cairo.OPERATOR_DEST_IN)
        m = cairo.LinearGradient(0, 0, 0, h)
        m.add_color_stop_rgba(0, 0, 0, 0, 1)
        m.add_color_stop_rgba(.8, 0, 0, 0, .8)
        m.add_color_stop_rgba(1, 0, 0, 0, 0)
        cr.set_source(m)
        cr.paint()


class Rain(Layer):
    """Drops on the active window's title bar; some slide down its sides."""
    def __init__(self):
        super().__init__("Frutiger Rain on Glass")
        self.geo, self.drops, self.xid = None, [], None

    def follow(self, w):
        if w is None or w.is_minimized() or w.is_fullscreen():
            self.hide()
            self.geo = None
            return
        if w.get_xid() != self.xid:
            self.xid, self.drops = w.get_xid(), []
        geo = w.get_geometry()
        if geo != self.geo:
            self.geo = geo
            self.place(*geo)
        if not self.get_visible():
            self.show_all()

    def step(self, dt, raining):
        if not self.geo:
            return
        _x, _y, w, h = self.geo
        now = time.monotonic()
        if raining and len(self.drops) < 28 and random.random() < dt * 2.4:
            s = 4 + random.random() * 5
            if random.random() < .6:
                self.drops.append({"x": 6 + random.random() * max(10, w - 150), "y": 3 + random.random() * 20, "s": s,
                                   "born": now, "life": 5 + random.random() * 6, "vy": 0})
            else:
                self.drops.append({"x": (2 if random.random() < .5 else w - 4), "y": 34 + random.random() * h * .3, "s": s,
                                   "born": now, "life": 1.5 + random.random() * 2.5, "vy": 1})
        keep = []
        for d in self.drops:
            if d["vy"]:
                d["y"] += (h - d["y"]) * min(1, dt / max(.2, d["life"] - (now - d["born"])))
            if now - d["born"] < d["life"] + .8:
                keep.append(d)
        if not raining:
            keep = [d for d in keep if now - d["born"] < d["life"] + .8]
        self.drops = keep
        if self.drops:
            self.queue_draw()
        elif self.get_visible() and not raining:
            self.hide()

    def paint(self, cr):
        now = time.monotonic()
        for d in self.drops:
            age = now - d["born"]
            a = 1 if age < d["life"] else max(0, 1 - (age - d["life"]) / .8)
            x, y, s = d["x"], d["y"], d["s"]
            r = s / 2
            cr.save()
            cr.translate(x, y)
            cr.scale(1, 1.12)
            g = cairo.RadialGradient(-r * .28, -r * .4, r * .05, 0, 0, r)
            g.add_color_stop_rgba(0, 1, 1, 1, .95 * a)
            g.add_color_stop_rgba(.3, 1, 1, 1, .25 * a)
            g.add_color_stop_rgba(.75, .12, .35, .63, .22 * a)
            g.add_color_stop_rgba(.92, 1, 1, 1, .7 * a)
            g.add_color_stop_rgba(1, 1, 1, 1, 0)
            cr.arc(0, 0, r, 0, 2 * math.pi)
            cr.set_source(g)
            cr.fill()
            cr.restore()


class PeekCorner(Gtk.Window):
    """A tiny hot corner at the bottom right of the screen."""
    def __init__(self):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.set_title("Frutiger Peek Corner")
        self.set_app_paintable(True)
        vis = self.get_screen().get_rgba_visual()
        if vis:
            self.set_visual(vis)
        self.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK | Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect("draw", lambda _w, cr: (cr.set_operator(cairo.OPERATOR_SOURCE), cr.set_source_rgba(0, 0, 0, 0), cr.paint(), False)[-1])
        self.connect("enter-notify-event", self.on_enter)
        self.connect("leave-notify-event", self.on_leave)
        self.connect("button-press-event", self.on_click)
        self.timer = 0
        disp = Gdk.Display.get_default()
        g = (disp.get_primary_monitor() or disp.get_monitor(0)).get_geometry()
        self.move(g.x + g.width - 6, g.y + g.height - 6)
        self.resize(6, 6)

    def on_enter(self, *_):
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add(420, self.start)

    def start(self):
        self.timer = 0
        peek.peek()
        return False

    def on_leave(self, *_):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = 0
        peek.unpeek()

    def on_click(self, *_):                    # click = show the desktop (minimize all), like Windows 7
        peek.unpeek()
        scr = Wnck.Screen.get_default()
        scr.toggle_showing_desktop(not scr.get_showing_desktop())
        return True


class Aero:
    def __init__(self):
        self.cfg, self.cfg_at = fs.load(), time.monotonic()
        self.scr = Wnck.Screen.get_default()
        self.shine, self.rain, self.corner = Shine(), Rain(), PeekCorner()
        self.last_active = None
        self.scr.connect("active-window-changed", self.on_active)
        self.last = time.monotonic()
        self.apply()
        GLib.timeout_add(50, self.tick)

    def on(self, key):
        return fs.on(self.cfg, key)

    def composited(self):
        return Gdk.Screen.get_default().is_composited()

    def apply(self):
        if self.on("aero_peek"):
            self.corner.show_all()
        else:
            self.corner.hide()
            peek.unpeek()

    def ordinary(self, w):
        return w is not None and w.get_window_type() in (Wnck.WindowType.NORMAL, Wnck.WindowType.DIALOG)

    def on_active(self, scr, prev):
        w = scr.get_active_window()
        if not self.ordinary(w) or w.get_xid() == self.last_active:
            return
        self.last_active = w.get_xid()
        if self.on("aero_shine") and self.composited() and not w.is_minimized() and not w.is_fullscreen():
            self.shine.sweep(w.get_geometry())

    def tick(self):
        now = time.monotonic()
        dt, self.last = min(.2, now - self.last), now
        if now - self.cfg_at > 3:
            old = (self.on("aero_peek"),)
            self.cfg, self.cfg_at = fs.load(), now
            if (self.on("aero_peek"),) != old:
                self.apply()
        try:
            raining = self.on("weather_effects") and open(RAINING).read().strip() == "1"
        except OSError:
            raining = False
        if (raining or self.rain.drops) and self.composited():
            w = self.scr.get_active_window()
            self.rain.follow(w if self.ordinary(w) else None)
            self.rain.step(dt, raining)
        elif self.rain.get_visible():
            self.rain.hide()
        return True


if __name__ == "__main__":
    GLib.set_prgname("frutiger-aero")
    Aero()
    Gtk.main()
