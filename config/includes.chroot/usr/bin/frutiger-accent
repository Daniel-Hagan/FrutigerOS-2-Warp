#!/usr/bin/env python3
"""frutiger-accent — set the glass colour (window frames, panel, Start menu, Bubble Dock, taskbars).

  frutiger-accent '#2aa7e8'      set it (what Personalize → Appearance does)
  frutiger-accent --match '#c26447'
                                 used by "Match the wallpaper": remembers your own colour the
                                 first time, then tints the glass to match the wallpaper
  frutiger-accent --restore      back to your own colour (when "Match the wallpaper" is turned off)
"""
import os, re, shutil, subprocess, sys

HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".config/frutiger")
MARK_A, MARK_B = "/* frutiger-personalize: begin */", "/* frutiger-personalize: end */"


def read(name, default):
    try:
        return open(os.path.join(CONF, name)).read().strip()
    except OSError:
        return default


def write(name, value):
    os.makedirs(CONF, exist_ok=True)
    open(os.path.join(CONF, name), "w").write(value + "\n")


def run(*cmd):
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def apply(a):
    alpha = int(read("intensity", "45") or 45) / 100
    write("accent", a)
    gtkcss = os.path.join(HOME, ".config/gtk-3.0/gtk.css")
    os.makedirs(os.path.dirname(gtkcss), exist_ok=True)
    old = open(gtkcss).read() if os.path.exists(gtkcss) else ""
    old = re.sub(re.escape(MARK_A) + r".*?" + re.escape(MARK_B) + r"\n?", "", old, flags=re.S)
    block = (f"{MARK_A}\n@define-color accent {a};\n"
             f".xfce4-panel {{ background-color: alpha({a}, {alpha * .85:.2f}); }}\n"
             f"#whiskermenu-window {{ background-color: alpha({a}, {min(1, alpha + .1):.2f}); }}\n{MARK_B}\n")
    open(gtkcss, "w").write(old + block)
    run("xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName", "-s", "Adwaita")
    run("xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName", "-s", "Frutiger-Aero")
    user_theme = os.path.join(HOME, ".local/share/themes/Frutiger-Aero-Custom")
    os.makedirs(os.path.join(user_theme, "xfwm4"), exist_ok=True)
    shutil.copy("/usr/share/themes/Frutiger-Aero/xfwm4/themerc", os.path.join(user_theme, "xfwm4/themerc"))
    run("python3", "/usr/share/frutiger/gen_assets.py", "--accent", a.lstrip("#"),
        "--alpha", f"{min(.95, alpha + .1):.2f}", "--out", os.path.join(user_theme, "xfwm4"))
    run("xfconf-query", "-c", "xfwm4", "-p", "/general/theme", "-s", "Default")
    run("xfconf-query", "-c", "xfwm4", "-p", "/general/theme", "-s", "Frutiger-Aero-Custom")
    try:
        src = open("/usr/share/plank/themes/Frutiger-Bubble/dock.theme").read()
        r, g, b = (int(a[i:i + 2], 16) for i in (1, 3, 5))
        src = re.sub(r"FillEndColor=.*", f"FillEndColor={r};;{g};;{b};;{int(alpha * 255)}", src)
        pdir = os.path.join(HOME, ".local/share/plank/themes/Frutiger-Custom")
        os.makedirs(pdir, exist_ok=True)
        open(os.path.join(pdir, "dock.theme"), "w").write(src)
        run("gsettings", "set", "net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/", "theme", "Frutiger-Custom")
    except OSError:
        pass


def valid(c):
    return bool(re.fullmatch(r"#[0-9a-fA-F]{6}", c or ""))


def main(a):
    if not a or a[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if a[0] == "--restore":
        own = read("accent-own", "")
        if valid(own):
            apply(own)
        try:
            os.remove(os.path.join(CONF, "accent-own"))
        except OSError:
            pass
        return 0
    if a[0] == "--match" and len(a) > 1 and valid(a[1]):
        if not os.path.exists(os.path.join(CONF, "accent-own")):
            write("accent-own", read("accent", "#2aa7e8"))
        if read("accent", "").lower() != a[1].lower():
            apply(a[1])
        return 0
    if valid(a[0]):
        apply(a[0])
        return 0
    print("Give a colour like #2aa7e8")
    return 2


sys.exit(main(sys.argv[1:]))
