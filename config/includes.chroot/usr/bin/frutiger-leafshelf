#!/usr/bin/env python3
"""Frutiger OS — Leaf Shelf taskbar.

A glass shelf along the bottom of the screen with a glossy branch running
through it. Each app grows a leaf: pinned apps that aren't running sway
gently, running apps glow, the active window's leaf carries a dewdrop, and a
leaf wanting attention pulses. Click a leaf to open/focus/minimize,
middle-click to close, right-click to pin/unpin. The orb opens the Start menu.
"""
import math, sys
sys.path.insert(0, "/usr/lib/frutiger")
from frutiger_strip import Strip, run, rounded, accent, cairo

LEAF_L, LEAF_W = 50, 24


class LeafShelf(Strip):
    TITLE = "Frutiger Leaf Shelf"
    PRGNAME = "frutiger-leafshelf"
    STRIP_H = 70
    EXTRA_H = 40
    item_radius = 24

    def branch_y(self, top):
        return top + self.STRIP_H - 14

    def draw_background(self, cr, w, h, top, t):
        H = self.STRIP_H
        ar, ag, ab = accent()
        rounded(cr, 4, top + 6, w - 8, H - 8, 14)            # glass shelf
        g = cairo.LinearGradient(0, top + 6, 0, top + H - 2)
        g.add_color_stop_rgba(0, 1, 1, 1, .55)
        g.add_color_stop_rgba(.48, 1, 1, 1, .18)
        g.add_color_stop_rgba(.5, ar, ag, ab, .22)
        g.add_color_stop_rgba(1, ar, ag, ab, .40)
        cr.set_source(g)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, .75)
        cr.set_line_width(1)
        cr.stroke()
        by = self.branch_y(top)                               # the branch
        x0, x1 = 70, w - 110
        cr.move_to(x0, by + 3)
        cr.curve_to(x0 + (x1 - x0) * .3, by - 4, x0 + (x1 - x0) * .6, by + 6, x1, by)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_width(8)
        bg = cairo.LinearGradient(0, by - 4, 0, by + 4)
        bg.add_color_stop_rgba(0, .62, .48, .30, 1)
        bg.add_color_stop_rgba(1, .36, .26, .14, 1)
        cr.set_source(bg)
        cr.stroke_preserve()
        cr.set_line_width(2)
        cr.set_source_rgba(1, 1, 1, .35)
        cr.stroke()

    def item_pos(self, i, n, it, w, top, t):
        x0, x1 = 100, w - 140
        step = min(80, (x1 - x0) / max(1, n))
        return x0 + step * (i + .5), self.branch_y(top) - LEAF_L / 2

    def draw_item(self, cr, it, x, y, t, hover):
        ax, ay = x, y + LEAF_L / 2                            # where the leaf meets the branch
        sway = math.sin(t * .9 + it.seed * 6.28) * (.07 if not it.running else .025)
        if hover:
            sway = 0
        alpha = 1.0 if it.running else .7
        if it.running:                                        # soft glow behind running leaves
            pulse = (.55 + .45 * math.sin(t * 4)) if it.attention else (1 if it.active else .6)
            gr = cairo.RadialGradient(x, y, 4, x, y, LEAF_L * .75)
            gr.add_color_stop_rgba(0, .75, 1, .55, .55 * pulse)
            gr.add_color_stop_rgba(1, .75, 1, .55, 0)
            cr.set_source(gr)
            cr.arc(x, y, LEAF_L * .75, 0, 2 * math.pi)
            cr.fill()
        cr.save()
        cr.translate(ax, ay)
        cr.rotate(sway)
        L, W = LEAF_L, LEAF_W
        cr.move_to(0, 0)                                      # leaf blade
        cr.curve_to(-W, -L * .3, -W * .8, -L * .8, 0, -L)
        cr.curve_to(W * .8, -L * .8, W, -L * .3, 0, 0)
        cr.close_path()
        g = cairo.LinearGradient(-W, -L, W, 0)
        if it.running:
            g.add_color_stop_rgba(0, .78, 1, .45, alpha)
            g.add_color_stop_rgba(1, .18, .62, .16, alpha)
        else:
            g.add_color_stop_rgba(0, .85, .97, .7, alpha)
            g.add_color_stop_rgba(1, .45, .72, .38, alpha)
        cr.set_source(g)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, .8 * alpha)
        cr.set_line_width(1.2)
        cr.stroke()
        cr.move_to(0, -2)                                     # midrib
        cr.curve_to(-1, -L * .4, 1, -L * .7, 0, -L + 4)
        cr.set_source_rgba(1, 1, 1, .45 * alpha)
        cr.set_line_width(1)
        cr.stroke()
        cr.move_to(-2, -L * .15)                              # gloss on the left half
        cr.curve_to(-W * .8, -L * .35, -W * .6, -L * .75, -1, -L * .92)
        cr.curve_to(-W * .3, -L * .7, -W * .35, -L * .35, -2, -L * .15)
        gl = cairo.LinearGradient(-W, -L, 0, -L * .2)
        gl.add_color_stop_rgba(0, 1, 1, 1, .7 * alpha)
        gl.add_color_stop_rgba(1, 1, 1, 1, 0)
        cr.set_source(gl)
        cr.fill()
        if it.active:                                         # dewdrop near the tip
            cr.arc(W * .25, -L * .8, 4, 0, 2 * math.pi)
            dg = cairo.RadialGradient(W * .25 - 1.5, -L * .8 - 1.5, .5, W * .25, -L * .8, 4)
            dg.add_color_stop_rgba(0, 1, 1, 1, 1)
            dg.add_color_stop_rgba(1, .6, .9, 1, .5)
            cr.set_source(dg)
            cr.fill()
        cr.restore()
        cx = ax + math.sin(sway) * L * .5                     # icon at the leaf's (swayed) centre
        cy = ay - math.cos(sway) * L * .5
        self.paint_icon(cr, it, cx, cy, 24, alpha)
        n = len(it.windows)
        for k in range(min(n, 4) if n > 1 else 0):           # dots for extra windows
            cr.set_source_rgba(1, 1, 1, .9)
            cr.arc(ax - (min(n, 4) - 1) * 4 + k * 8, ay + 8, 2, 0, 2 * math.pi)
            cr.fill()


if __name__ == "__main__":
    run(LeafShelf)
