---
# Frutiger OS installer branding (Calamares 3.2)
componentName:  frutiger

welcomeStyleCalamares:   false
welcomeExpandingLogo:    true
windowExpanding:         normal
windowSize:              960px,640px
windowPlacement:         center
sidebar:                 widget
navigation:              widget

strings:
    productName:         "Frutiger OS"
    shortProductName:    "Frutiger OS"
    version:             "1.0"
    shortVersion:        "1.0"
    versionedName:       "Frutiger OS 1.0 “Lagoon”"
    shortVersionedName:  "Frutiger OS 1.0"
    bootloaderEntryName: "Frutiger"

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPI:            2

style:
   sidebarBackground:    "#1f6fb8"
   sidebarText:          "#FFFFFF"
   sidebarTextSelect:    "#0b1d33"
   sidebarTextHighlight: "#d4ecfd"
