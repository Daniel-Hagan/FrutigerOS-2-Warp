#!/bin/sh
# Frutiger OS: brand the live ISO's boot menus (runs in the binary stage).
#  - UEFI (GRUB): use the Frutiger GRUB theme from the image
#  - BIOS (isolinux): Frutiger splash, colors and layout
#  - Menu entries renamed ("Live system" -> "Start Frutiger OS")
set -e
[ -d binary ] && cd binary          # live-build may run us from the build dir
CHROOT=../chroot
THEME_SRC=$CHROOT/usr/share/grub/themes/frutiger

rename_entries() {
  sed -i -e 's/Live system/Start Frutiger OS/g' \
         -e 's/Debian GNU\/Linux/Frutiger OS/g' \
         -e 's/Debian Live/Frutiger OS/g' "$@"
}

# ---------- GRUB (UEFI, and BIOS when GRUB is used) ----------
if [ -f boot/grub/grub.cfg ] && [ -d "$THEME_SRC" ]; then
  mkdir -p boot/grub/frutiger
  cp -r "$THEME_SRC"/. boot/grub/frutiger/
  rm -f boot/grub/frutiger/isolinux-splash.png
  rename_entries boot/grub/*.cfg
  cat >> boot/grub/grub.cfg <<'CFG'

# --- Frutiger OS boot menu theme ---
insmod all_video
insmod gfxterm
insmod png
loadfont /boot/grub/frutiger/frutiger-sans-18.pf2
loadfont /boot/grub/frutiger/frutiger-sans-24.pf2
set gfxmode=auto
terminal_output gfxterm
set theme=/boot/grub/frutiger/theme.txt
export theme
CFG
fi

# ---------- isolinux (legacy BIOS) ----------
if [ -d isolinux ]; then
  [ -f "$THEME_SRC/isolinux-splash.png" ] && cp "$THEME_SRC/isolinux-splash.png" isolinux/splash.png
  rename_entries isolinux/*.cfg
  sed -i 's/^menu title.*/menu title Choose how to start/' isolinux/*.cfg
  STD=isolinux/stdmenu.cfg; [ -f "$STD" ] || STD=isolinux/menu.cfg
  cat >> "$STD" <<'CFG'

# --- Frutiger OS layout: menu inside the glass panel of splash.png ---
menu background splash.png
menu hshift 20
menu width 40
menu vshift 15
menu rows 6
menu margin 1
menu tabmsgrow 24
menu timeoutrow 25
menu helpmsgrow 26
menu color screen      37;40      #00000000 #00000000 none
menu color border      30;44      #00000000 #00000000 none
menu color title       1;36;44    #ff1e3f7a #00000000 none
menu color unsel       37;44      #ff10223a #00000000 none
menu color hotkey      1;37;44    #ff1a6fc4 #00000000 none
menu color sel         7;37;40    #ff0b1d33 #ffc4e2ff none
menu color hotsel      1;7;37;40  #ff1a6fc4 #ffc4e2ff none
menu color disabled    1;30;44    #ff8a9aaa #00000000 none
menu color scrollbar   30;44      #00000000 #00000000 none
menu color tabmsg      31;40      #ff335577 #00000000 none
menu color cmdmark     1;36;40    #ff1a6fc4 #00000000 none
menu color cmdline     37;40      #ff10223a #00000000 none
menu color timeout_msg 37;40      #ff335577 #00000000 none
menu color timeout     1;37;40    #ff1a6fc4 #00000000 none
menu color help        37;40      #ff335577 #00000000 none
CFG
fi
